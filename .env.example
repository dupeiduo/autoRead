# ============================================================
# AutoRead 环境变量示例
# 复制为 .env 后按需修改：  cp .env.example .env
# .env 已被 .gitignore 忽略；这里没有密钥，但习惯上不入库。
#
# 优先级：内置默认值 < config/config.json < 环境变量 < 命令行参数
# ============================================================

# ---------- 可选：日志 ----------
AUTOREAD_LOG_LEVEL=INFO

# ---------- 可选：输出位置 ----------
AUTOREAD_OUTPUT_DIR=data/output
AUTOREAD_WORK_DIR=data/work

# ---------- 可选：TTS 引擎 ----------
# auto | edge | macos_say | silence
# auto：优先 Edge（音色好），不可用时回落到 macOS say（离线但只有女声）
AUTOREAD_TTS_ENGINE=auto
# 兜底引擎。设 none = 宁愿这一章不产出，也不发「机器音」。
AUTOREAD_TTS_FALLBACK_ENGINE=macos_say

# ---------- 可选：Edge 音色与韵律 ----------
# 云健：微软为「小说/体育解说」训练的成熟磁性男声，说书首选
AUTOREAD_TTS_VOICE=zh-CN-YunjianNeural
# 备选：zh-CN-YunyangNeural(新闻腔) / zh-CN-YunxiNeural(年轻) / zh-CN-YunxiaNeural(少年)
# 基准语速/音高。说书要稳：比默认略慢、略沉。
# 实测 -12% ≈ 4.2 字/秒（新闻播报约 5.5~6 字/秒）
AUTOREAD_EDGE_RATE=-12%
AUTOREAD_EDGE_PITCH=-2Hz
# 能 `import edge_tts` 的解释器；留空则自动发现项目里的 .venv
AUTOREAD_EDGE_PYTHON=
# 并发请求数（默认 5）。整本书跑几百段时，留点余量能掩盖偶发的连接卡顿。
AUTOREAD_EDGE_CONCURRENCY=5

# ---------- 可选：输出格式 ----------
# mp3（体积小，听书首选）/ wav
AUTOREAD_TTS_FORMAT=mp3
AUTOREAD_TTS_MP3_BITRATE=64k

# ---------- 可选：macOS 兜底音色 ----------
# 留空则自动挑一个中文语音。注意：简体中文通常只有女声 Ting-Ting。
AUTOREAD_MACOS_VOICE=

# ---------- 可选：停顿 ----------
# 停顿只留给「段落换行」。段落内部的排版换行会被归并，不产生停顿。
# 段落换行停顿（毫秒）：整章唯一明确的分节信号，调大 = 分节感更强。
AUTOREAD_PARAGRAPH_PAUSE_MS=800
# 句末基准停顿（毫秒）：普通句号收尾 ≈ 此值；分句（逗号）更短，短句/叹句更长，
# 但句末永远不会盖过段落停顿。
AUTOREAD_BASE_PAUSE_MS=500

# ---------- 可选：分页与韵律 ----------
# 「一页」的字符预算（只为 --pages 预览与进度估算服务）
AUTOREAD_CHARS_PER_PAGE=500
# 逐句抑扬顿挫开关。设 0 = 全场一个调（对照实验用）
AUTOREAD_PROSODY=1

# ============================================================
# 系统级依赖（不是 pip 包）
# ============================================================
# ffmpeg (必需)   macOS: brew install ffmpeg   Ubuntu: sudo apt install ffmpeg
#
# 可选但强烈建议：更好的中文男声（免费、需联网）
#   python3 -m venv .venv && ./.venv/bin/pip install edge-tts
